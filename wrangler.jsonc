{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kids-channels",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/_shell*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kids-channels",
      "database_id": "5cec8cc9-661f-407a-9d0c-653c7f6df3a4",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  },
  "env": {
    "development": {
      "name": "kids-channels-development",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kids-channels-development",
          "database_id": "531abb60-edab-447c-8dcb-ef79a3d898b2",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
