{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kids-channels",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kids-channels",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
