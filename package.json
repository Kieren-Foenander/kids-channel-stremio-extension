{
  "name": "stremio-extension",
  "version": "0.1.0",
  "description": "Parent-curated TV and Movie Channels for Stremio.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kids-channels --local",
    "db:migrate:remote": "wrangler d1 migrations apply kids-channels --remote",
    "test": "vitest run && vitest run --config vitest.component.config.ts",
    "test:watch": "vitest",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:browser": "playwright test",
    "test:all": "pnpm test && pnpm test:browser",
    "typecheck": "tsc"
  },
  "keywords": [
    "stremio",
    "addon"
  ],
  "author": "Kieren Foenander",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "~0.18.8",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "~4.1.10",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  }
}
