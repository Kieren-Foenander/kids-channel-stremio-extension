{
  "name": "stremio-extension",
  "version": "0.1.0",
  "description": "Parent-curated TV and Movie Channels for Stremio.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "build": "vite build && node scripts/harden-spa-shell.mjs",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:development": "pnpm build && wrangler deploy --env development",
    "db:migrate:local": "wrangler d1 migrations apply kids-channels --local",
    "db:migrate:remote": "wrangler d1 migrations apply kids-channels --remote",
    "db:migrate:development": "wrangler d1 migrations apply DB --remote --env development",
    "test": "pnpm build && pnpm test:migrations && vitest run && vitest run --config vitest.component.config.ts",
    "test:watch": "vitest",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:browser": "playwright test",
    "test:migrations": "node scripts/test-normalize-show-metadata-migration.mjs",
    "test:all": "pnpm test && pnpm test:browser",
    "typecheck": "tsc"
  },
  "keywords": [
    "stremio",
    "addon"
  ],
  "author": "Kieren Foenander",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "~0.20.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "~4.1.10",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.24",
    "@tanstack/react-start": "^1.168.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  }
}
