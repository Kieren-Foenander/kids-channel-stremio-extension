{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kids-channels-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/_shell*", "/assets/programme-unavailable-v2.mp4"]
  },
  "vars": {
    "CONFIG_SECRET": "test-only-configuration-secret-at-least-32-characters",
    "TV_SCHEDULE_SEED": "deterministic-test-seed",
    "AUTOMATIC_TV_PREPARATION_DISABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kids-channels-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "binding": "TV_PREPARATION",
      "name": "kids-channels-test-tv-preparation",
      "class_name": "TvSchedulePreparationWorkflow"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "0 3 * * *"]
  }
}
